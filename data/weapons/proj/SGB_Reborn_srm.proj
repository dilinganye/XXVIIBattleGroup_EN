{
	"id":"SGB_Reborn_srm",
	"specClass":"missile",	
	"missileType":"MISSILE",
	"onHitEffect":"data.weapons.SGB_Missile_Weapon_SMS",
	"sprite":"graphics/missiles/shell_round_large.png",
	"size":[10,10],
	"center":[5,5],
	"collisionRadius":7,
	"collisionClass":"MISSILE_NO_FF",
	"explosionColor":[255,165,50,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":60, # purely visual
	"fadeTime":1, # fadeout duration
	"engineSpec":{"turnAcc":1000,
				  "turnRate":1000,
				  "acc":90,
				  "dec":10},
	"engineSlots":[{"id":"ES1",
					"loc":[0, 0],
				    #"style":"MISSILE_MIDLINE",
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[255,145,75,0],
						"contrailDuration":.0,
						"contrailWidthMult":0,
						"contrailWidthAddedFractionAtEnd":0,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":15, # min segment length, in pixels
						"contrailMaxSpeedMult":.0f,
						"contrailAngularVelocityMult":0.0,
						"contrailSpawnDistMult":.0, # how far away from engine it starts
						"contrailColor":[100,100,100,0],
						"type":"GLOW" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":1.0,
				    "length":20.0,
				    "angle":180.0}],
	"behaviorSpec":{"behavior":"MIRV",
					"splitRange":2000,
					"minTimeToSplit":1,
					"canSplitEarly":true,
					"splitSound":"hurricane_mirv_split",
					"numShots":1,
					"damage":150,
					"impact":-50,
					"emp":100,
					"damageType":HIGH_EXPLOSIVE,
					"hitpoints":500,
					"evenSpread":false,
					"spreadSpeed":50,
					"spreadSpeedRange":50,
					"projectileSpec":"SGB_Reborn_srm_energy",
					"smokeSpec":{"particleSizeMin":30.0,
								 "particleSizeRange":30.0,
